# {{ ansible_managed }}
# Administrative SSH for the BearJug sensor. Port {{ bearjug_honeypot_port }} belongs to the
# honeypot; the firewall admits this port only from {{ bearjug_admin_cidrs | join(', ') }}.
Port {{ bearjug_admin_ssh_port }}
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin {{ bearjug_admin_permit_root_login }}
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
