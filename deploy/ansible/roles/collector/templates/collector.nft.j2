#!/usr/sbin/nft -f
# {{ ansible_managed }}
#
# BearJug collector firewall:
#   * the ingestion port only from the sensors: {{ bearjug_sensor_addresses | join(', ') }};
#   * administrative SSH only from {{ bearjug_admin_cidrs | join(', ') }};
#   * no new connection from this machine to any sensor, on any port.
#     Sensors push evidence; the collector never reaches into them.

define INGEST_PORT = {{ bearjug_collector_port }}
define ADMIN_PORT = {{ bearjug_admin_ssh_port }}

table inet bearjug
delete table inet bearjug

table inet bearjug {
{% set admin_v4 = bearjug_admin_cidrs | select('search', '^[0-9.]+(/[0-9]+)?$') | list %}
{% set admin_v6 = bearjug_admin_cidrs | reject('search', '^[0-9.]+(/[0-9]+)?$') | list %}
	set sensors {
		type ipv4_addr
		elements = { {{ bearjug_sensor_addresses | unique | join(', ') }} }
	}

	set admin_v4 {
		type ipv4_addr
		flags interval
{% if admin_v4 %}
		elements = { {{ admin_v4 | join(', ') }} }
{% endif %}
	}

	set admin_v6 {
		type ipv6_addr
		flags interval
{% if admin_v6 %}
		elements = { {{ admin_v6 | join(', ') }} }
{% endif %}
	}

	chain input {
		type filter hook input priority filter - 10; policy drop;
		ct state invalid drop
		ct state established,related accept
		iif "lo" accept
		tcp dport $INGEST_PORT ip saddr @sensors accept
		tcp dport $ADMIN_PORT ip saddr @admin_v4 accept
		tcp dport $ADMIN_PORT ip6 saddr @admin_v6 accept
		icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 10/second accept
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		udp sport 67 udp dport 68 accept comment "DHCPv4 client"
		udp sport 547 udp dport 546 accept comment "DHCPv6 client"
		counter drop
	}

	chain output {
		type filter hook output priority filter - 10; policy accept;
		ct state established,related accept
		ip daddr @sensors counter drop comment "bearjug: the collector never initiates into a sensor"
		meta skuid "bearjug-collector" counter drop comment "bearjug: the collector service makes no outbound connections"
	}
}
