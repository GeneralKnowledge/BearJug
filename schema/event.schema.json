            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "kind": {
          "$ref": "#/$defs/PolicyKind"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AuthPolicy",
      "type": "object"
    },
